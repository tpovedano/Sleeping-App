# Contraseña para entrar a la aplicación (obligatoria)
APP_PASSWORD=cambia-esta-contraseña

# Secreto para firmar la cookie de sesión (recomendado, cadena larga aleatoria).
# Si no se define se deriva de APP_PASSWORD.
AUTH_SECRET=

# Cadena de conexión de Neon. La integración Neon de Vercel la crea automáticamente.
DATABASE_URL=

# Zona horaria usada para agrupar los registros por día en las estadísticas
APP_TIMEZONE=America/Costa_Rica
